fund_cis <- population_pool %>%
rep_sample_n(size = T_obs, reps = 100, replace = FALSE) %>%
group_by(replicate) %>%
nest() %>%
mutate(
sample_mean = map_dbl(data, ~ mean(.x$ret)),
bootstraps  = map(data, bootstrap_pipeline)
) %>%
mutate(
pct_ci = map(bootstraps, get_ci, type = "percentile", level = 0.95)
) %>%
unnest(pct_ci)
View(fund_cis)
set.seed(99)
# 모집단에서 100개의 서로 다른 36개월 표본 생성
bootstrap_pipeline <- function(sample_data) {
sample_data %>%
specify(response = ret) %>%
generate(reps = 500, type = "bootstrap") %>%
calculate(stat = "mean")
}
population_pool <- tibble(
obs_id = 1:10000,
ret    = rnorm(10000, mean = true_alpha, sd = true_sigma)
)
fund_cis <- population_pool %>%
rep_sample_n(size = T_obs, reps = 100, replace = FALSE) %>%
group_by(replicate) %>%
nest() %>%
mutate(
sample_mean = map_dbl(data, ~ mean(.x$ret)),
bootstraps  = map(data, bootstrap_pipeline)
) %>%
mutate(
pct_ci = map(bootstraps, get_ci, type = "percentile", level = 0.95)
) %>%
unnest(pct_ci) %>%
rename(lb = lower_ci, ub = upper_ci) %>%
mutate(captured = lb <= true_alpha & true_alpha <= ub)
n_captured <- sum(fund_cis$captured)
ggplot(fund_cis) +
geom_segment(aes(
y = replicate, yend = replicate,
x = lb * 100, xend = ub * 100,
alpha = factor(captured, levels = c("TRUE","FALSE"))
)) +
geom_point(aes(
y = replicate, x = sample_mean * 100,
alpha = factor(captured, levels = c("TRUE","FALSE"))
)) +
geom_vline(xintercept = true_alpha * 100,
color = "#d90502", linewidth = 1, linetype = "dashed") +
annotate("text", x = true_alpha * 100 + 0.15, y = 5,
label = sprintf("진짜 α = %.1f%%", true_alpha * 100),
col = "#d90502", size = 3.5) +
labs(
x     = expression(hat(alpha) ~ "(%/월)"),
y     = "신뢰 구간 번호",
alpha = "진짜 α 포함?"
) +
coord_flip() +
theme_bw(base_size = 13) +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank(),
legend.position    = "top"
)
